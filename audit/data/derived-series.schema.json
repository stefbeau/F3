{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/stefbeau/F3/audit/data/derived-series.schema.json",
 "title": "F3 derived series (D-058)",
 "description": "A series built by site_src/data_campaign.py from registered raw files. Provenance fields are mandatory.",
 "type": "object",
 "required": ["id", "title", "description", "built_by", "register", "sources", "source_files", "retrieved", "redistribution", "attribution", "units", "geography", "time_span", "variables", "supports", "method", "caveats", "data"],
 "properties": {
  "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
  "title": {"type": "string", "minLength": 5},
  "description": {"type": "string", "minLength": 10},
  "built_by": {"const": "site_src/data_campaign.py"},
  "register": {"const": "audit/data/sources-register.json"},
  "sources": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "title", "version", "url", "licence", "licence_quote", "redistribution"], "properties": {"id": {"type": "string"}, "redistribution": {"const": "yes"}, "licence_quote": {"type": "string", "minLength": 5}}}},
  "source_files": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["path", "sha256", "bytes"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "bytes": {"type": "integer", "minimum": 1}}}},
  "retrieved": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
  "redistribution": {"const": "yes"},
  "attribution": {"type": "string", "minLength": 10},
  "units": {"type": "string", "minLength": 1},
  "geography": {"type": "string", "minLength": 1},
  "time_span": {"type": "string", "minLength": 1},
  "variables": {"type": "array", "minItems": 1, "items": {"type": "string"}},
  "supports": {"type": "array", "minItems": 1, "items": {"type": "string", "enum": ["L3", "L4", "L5", "L6", "L7", "DC", "AI", "M5"]}},
  "method": {"type": "string", "minLength": 20},
  "caveats": {"type": "array", "items": {"type": "string"}},
  "data": {"type": ["object", "array"]}
 }
}
